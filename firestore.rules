rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isNotBanned() { return isSignedIn() && (!exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('isBanned', false) != true); }
    function isVerified() { return isSignedIn() && isNotBanned(); }
    function isOwner(userId) { return isSignedIn() && (request.auth.uid == userId); }
    function isAdmin() { return isSignedIn() && (request.auth.token.email == 'mustaphaelibrahimi6@gmail.com' || (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('role', 'user') == 'admin')); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 3. Validation Helpers
    function isValidProfile(data) {
      return data.keys().hasAll(['id', 'email', 'username', 'avatar_url', 'role', 'created_at']) &&
             data.id is string &&
             data.email is string &&
             data.username is string &&
             data.avatar_url is string &&
             data.role in ['user', 'admin'] &&
             data.created_at is string;
    }

    // 4. Match Blocks

    // Profiles
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if (isOwner(userId) && isValidProfile(incoming()) && incoming().role == existing().role) || isAdmin();
    }

    // Lists
    match /lists/{listId} {
      allow read: if true;
      allow create: if isVerified() && incoming().user_id == request.auth.uid;
      allow update, delete: if isVerified() && (isOwner(existing().user_id) || isAdmin());
    }

    // Favorites & Wishlists
    match /favorites/{favId} {
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow get: if isSignedIn();
      allow create: if isVerified() && incoming().user_id == request.auth.uid;
      allow delete: if isOwner(existing().user_id) || isAdmin();
    }
    
    match /wishlists/{wishId} {
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow get: if isSignedIn();
      allow create: if isVerified() && incoming().user_id == request.auth.uid;
      allow delete: if isOwner(existing().user_id) || isAdmin();
    }

    // Game Stats
    match /game_stats/{statId} {
      allow read: if true;
      allow create, update: if true; // In real app, we'd use a cloud function or stricter increment rules
    }

    // Homepage Config
    match /homepage_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ratings
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isVerified() && incoming().user_id == request.auth.uid;
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isVerified() && incoming().user_id == request.auth.uid && incoming().username is string && incoming().content.size() <= 1000;
      allow update: if isVerified() && (isOwner(existing().user_id) || isAdmin()) && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'likes']);
      allow delete: if isVerified() && (isOwner(existing().user_id) || isAdmin());
    }

    // Affiliate Links (Admin only)
    match /affiliate_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Affiliate Clicks
    match /affiliate_clicks/{clickId} {
      allow create: if true; // Public can click
      allow read: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, update: if isOwner(resource.data.user_id);
      allow create: if isAdmin();
    }
  }
}
